#!/bin/bash
# Edit Lab Site launcher.
#
# Previous behavior: waited on the edit server's health endpoint, then opened
# the browser unconditionally. If Jekyll had died, Safari/Chrome opened onto a
# dead port 4000 and showed "unable to reach site" with no explanation, while
# the Terminal window scrolled the real error out of view. This version waits
# on the thing the browser actually needs (Jekyll on 4000) and simply does not
# open a browser if the server never came up, leaving the error on screen.

REPO="/Users/blackmon/Desktop/GitHub/coleoguy.github.io"
EDIT_URL="http://127.0.0.1:4000/knowledge/topics/sex_chromosome_evolution/?edit=1"
JEKYLL_ROOT="http://127.0.0.1:4000/"

PREVIEW_ROOT="http://127.0.0.1:4010/index.html"

port_up() {
    code="$(curl -sf -o /dev/null -w '%{http_code}' --max-time 2 "$1" 2>/dev/null)"
    case "$code" in 200|302|304) return 0 ;; *) return 1 ;; esac
}

jekyll_up()  { port_up "$JEKYLL_ROOT"; }
# With no Ruby installed, edit-start.sh falls back to the Python preview on
# 4010 and opens the browser itself. Treat that as success too, otherwise this
# launcher reports failure over a preview that is in fact running.
preview_up() { port_up "$PREVIEW_ROOT"; }

# Already serving? Just open the browser.
if jekyll_up; then
    open "$EDIT_URL"
    exit 0
fi

# Launch the start script in a Terminal window. The window stays open so any
# error remains readable; closing it stops the servers.
osascript <<EOF
tell application "Terminal"
    activate
    do script "cd '$REPO' && bash scripts/edit-start.sh && echo && echo '=== edit mode active ===' && echo 'Close this window to stop the servers.' && echo && trap 'cd \"$REPO\" && bash scripts/edit-stop.sh; exit' EXIT INT TERM HUP && tail -F /tmp/coleoguy-edit.log /tmp/coleoguy-jekyll.log"
end tell
EOF

# Wait up to 120s. A cold build of the full site including the wiki is slow,
# and opening the browser early is what produced the confusing error page.
for i in $(seq 1 120); do
    sleep 1
    if jekyll_up; then
        open "$EDIT_URL"
        exit 0
    fi
    if preview_up; then
        exit 0   # edit-start.sh already opened the preview in the browser
    fi
done

# Never came up. Do not open a browser onto a dead port; the Terminal window
# that is already in front has the actual error.
osascript -e 'display notification "Jekyll did not start. See the Terminal window for the error." with title "Edit Lab Site"' 2>/dev/null
exit 1
