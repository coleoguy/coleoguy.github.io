#!/bin/bash
# Edit Lab Site launcher — mirrors Start Tealc.app's pattern.
# Opens edit-start.sh inside a Terminal window (so TCC works via the
# already-trusted Terminal.app), then opens the browser once the edit
# server is responding. If already running, just opens the browser.

REPO="/Users/blackmon/Desktop/GitHub/coleoguy.github.io"
EDIT_URL="http://127.0.0.1:4000/knowledge/topics/sex_chromosome_evolution/?edit=1"
HEALTH="http://127.0.0.1:4711/health"

# If editing is already live, just open the browser.
if curl -sf --max-time 2 "$HEALTH" >/dev/null 2>&1; then
    open "$EDIT_URL"
    exit 0
fi

# Launch edit-start.sh in a new Terminal window. The window stays open
# tailing the logs; closing it stops the servers via the SIGHUP trap in
# edit-start.sh's caller workflow.
osascript <<EOF
tell application "Terminal"
    activate
    do script "cd '$REPO' && bash scripts/edit-start.sh && echo && echo '=== edit mode active ===' && echo 'Close this window to stop the servers.' && echo && trap 'cd \"$REPO\" && bash scripts/edit-stop.sh; exit' EXIT INT TERM HUP && tail -F /tmp/coleoguy-edit.log /tmp/coleoguy-jekyll.log"
end tell
EOF

# Wait up to 30s for the edit server to bind, then open the browser.
for i in {1..30}; do
    sleep 1
    if curl -sf --max-time 1 "$HEALTH" >/dev/null 2>&1; then
        break
    fi
done

open "$EDIT_URL"
