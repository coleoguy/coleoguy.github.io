.fuse_hidden*

# OS / editor cruft
.DS_Store
.Rhistory
.Rapp.history
.RData
*.swp
*.swo
*~

# Jekyll build output (GitHub Pages regenerates this from source)
_site/

# Jekyll incremental-build cache. Machine-specific and 300KB+; a stale copy
# written by a different Ruby or Jekyll makes --incremental serve broken pages.
.jekyll-metadata

# Local static preview bundle (generated, not source)
blackmon-site-preview.zip

# Local-only dev notes
next-session-tasks.md
context.md

# Tealc local audit log (served via Cloudflare Worker, not git)
tealc_activity.json
_site/tealc_activity.json
